# Copia este archivo a .env y llena tus datos. .env NUNCA se sube a GitHub.

IMAP_USER=pedro@dindustrimex.com
# Contraseña del buzón o "contraseña de aplicación" (Gmail / Google Workspace)
IMAP_PASSWORD=
# Para Microsoft 365 / Outlook: token OAuth2 en lugar de contraseña
IMAP_OAUTH_TOKEN=

# Vacío = se detecta solo con los registros MX del dominio
IMAP_HOST=
IMAP_PORT=993

# Carpetas separadas por coma, o ALL para todas
IMAP_FOLDERS=INBOX
BATCH_SIZE=50
BATCH_DELAY=1.0

# País por defecto para teléfonos sin +lada internacional
DEFAULT_REGION=MX

# También guardar a quien aparece en Para/CC aunque no tenga firma
INCLUDE_HEADER_CONTACTS=true
# No incluir el propio buzón en los resultados
EXCLUDE_SELF=true
# Dominios que no son prospectos (compañeros de trabajo). Vacío = el dominio de IMAP_USER;
# none = no excluir ninguno.
# Ejemplo: EXCLUDE_DOMAINS=dindustrimex.com,grupodindustrimex.mx
EXCLUDE_DOMAINS=
# Omitir noreply@, notifications@, mailer-daemon@...
SKIP_AUTOMATED=true

# OCR para firmas en imagen
OCR_IMAGES=true
OCR_LANG=spa+eng
# Descargar imágenes de firma alojadas en internet (avisa al remitente que abriste el correo)
OCR_REMOTE_IMAGES=false

OUTPUT_DIR=output
